# Copy to backend/.env and adjust. All settings use the NIPAM_ prefix.
NIPAM_ENV=development
NIPAM_DATABASE_URL=postgresql+psycopg://nipam:nipam@localhost:5432/nipam
NIPAM_SECRET_KEY=replace-with-64-random-characters
NIPAM_PUBLIC_BASE_URL=http://localhost:5173
NIPAM_CORS_ORIGINS=["http://localhost:5173"]
NIPAM_COOKIE_SECURE=false
NIPAM_DEV_EXPOSE_OTP=true

# Email: console (logs only) or smtp
NIPAM_EMAIL_PROVIDER=console
NIPAM_SMTP_HOST=
NIPAM_SMTP_PORT=587
NIPAM_SMTP_USER=
NIPAM_SMTP_PASSWORD=
NIPAM_SMTP_FROM=NIPAM <no-reply@example.org>

# SMS: none | console | http (connect an approved Nigerian SMS provider)
NIPAM_SMS_PROVIDER=none
NIPAM_SMS_HTTP_URL=
NIPAM_SMS_HTTP_TOKEN=
NIPAM_SMS_SENDER_ID=NIPAM

# Storage: local | s3
NIPAM_STORAGE_BACKEND=local
NIPAM_UPLOAD_DIR=./uploads

NIPAM_SEED_ADMIN_EMAIL=admin@nipam.local
NIPAM_SEED_ADMIN_PASSWORD=ChangeMe!Admin2026
