# Used by docker-compose.yml. Never commit the real .env.
POSTGRES_PASSWORD=change-me
NIPAM_ENV=production
NIPAM_SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
NIPAM_PUBLIC_BASE_URL=https://nipam.example.org
NIPAM_CORS_ORIGINS=["https://nipam.example.org"]
NIPAM_COOKIE_SECURE=true
NIPAM_DEV_EXPOSE_OTP=false
NIPAM_EMAIL_PROVIDER=smtp
NIPAM_SMTP_HOST=
NIPAM_SMTP_USER=
NIPAM_SMTP_PASSWORD=
NIPAM_SMTP_FROM=NIPAM <no-reply@nipam.example.org>
NIPAM_SMS_PROVIDER=none
NIPAM_SEED_ADMIN_EMAIL=admin@nipam.example.org
NIPAM_SEED_ADMIN_PASSWORD=choose-a-strong-password
