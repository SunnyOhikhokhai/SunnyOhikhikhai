# Copy this file to ".env" in the same folder and adjust the values.
# PowerShell:  Copy-Item .env.example .env
# Never commit your real .env file.

# Turn on Django's debug pages for local development only.
FINPLAN_DEBUG=True

# A long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# In development a fixed insecure key is used if this is empty.
FINPLAN_SECRET_KEY=

# Comma-separated host names allowed to serve the app.
FINPLAN_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated trusted origins for HTTPS deployments, e.g. https://finplan.example.com
FINPLAN_CSRF_TRUSTED_ORIGINS=

# --- Optional: PostgreSQL (leave FINPLAN_DB_NAME empty to use SQLite) ---
FINPLAN_DB_NAME=
FINPLAN_DB_USER=
FINPLAN_DB_PASSWORD=
FINPLAN_DB_HOST=localhost
FINPLAN_DB_PORT=5432

# --- Production security switches (set to True behind HTTPS) ---
FINPLAN_SECURE_COOKIES=False
FINPLAN_SSL_REDIRECT=False
